# Slack credentials — copy to .env and fill in
SLACK_BOT_TOKEN=xoxb-...   # Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...   # App-Level Token (Socket Mode, connections:write scope)

# Copy all other vars from the root .env — the Slack container needs them too
GROQ_API_KEY=
GENERATION_API_BASE=https://api.groq.com/openai/v1
GENERATION_MODEL=llama-3.3-70b-versatile
OLLAMA_API_BASE=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
QDRANT_URL=http://localhost:7333
QDRANT_COLLECTION=documents_chunks
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
RETRIEVAL_TOP_K=100
RERANK_TOP_N=10
