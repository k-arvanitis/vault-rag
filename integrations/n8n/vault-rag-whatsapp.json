{
  "name": "Vault RAG - WhatsApp Connector",
  "nodes": [
    {
      "parameters": {
        "updates": ["messages"]
      },
      "id": "2b2c3d4e-0001-4a00-8000-000000000001",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [-40, 0],
      "webhookId": "vault-rag-whatsapp",
      "credentials": {
        "whatsAppTriggerApi": {
          "id": "REPLACE_WITH_YOUR_WHATSAPP_CREDENTIAL_ID",
          "name": "WhatsApp account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VAULT_RAG_API_URL }}/query",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ question: $json.messages[0].text.body }) }}",
        "options": {}
      },
      "id": "2b2c3d4e-0002-4a00-8000-000000000002",
      "name": "Query Vault RAG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [180, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.answer }}",
              "rightValue": "Unsupported",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2b2c3d4e-0003-4a00-8000-000000000003",
      "name": "Needs human? (Unsupported)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [400, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "={{ $env.ESCALATION_SLACK_CHANNEL }}",
        "text": "=WhatsApp question needs a human:\n>{{ $('WhatsApp Trigger').item.json.messages[0].text.body }}\n\nFrom: {{ $('WhatsApp Trigger').item.json.messages[0].from }}\nVault RAG returned Unsupported."
      },
      "id": "2b2c3d4e-0004-4a00-8000-000000000004",
      "name": "Notify On-Call (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [620, -100],
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_YOUR_SLACK_CREDENTIAL_ID",
          "name": "Slack account"
        }
      }
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $env.WHATSAPP_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $('WhatsApp Trigger').item.json.messages[0].from }}",
        "textBody": "={{ $json.answer }}"
      },
      "id": "2b2c3d4e-0005-4a00-8000-000000000005",
      "name": "Reply on WhatsApp",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [620, 100],
      "credentials": {
        "whatsAppApi": {
          "id": "REPLACE_WITH_YOUR_WHATSAPP_CREDENTIAL_ID",
          "name": "WhatsApp account"
        }
      }
    }
  ],
  "connections": {
    "WhatsApp Trigger": {
      "main": [[{ "node": "Query Vault RAG", "type": "main", "index": 0 }]]
    },
    "Query Vault RAG": {
      "main": [[{ "node": "Needs human? (Unsupported)", "type": "main", "index": 0 }]]
    },
    "Needs human? (Unsupported)": {
      "main": [
        [{ "node": "Notify On-Call (Slack)", "type": "main", "index": 0 }],
        [{ "node": "Reply on WhatsApp", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
