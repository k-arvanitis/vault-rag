# Vault RAG — environment configuration
# Required: GROQ_API_KEY
# All other variables have working defaults
# Copy this file to .env and fill in your values

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
GROQ_API_KEY=                        # Required — get a free key at console.groq.com
NVIDIA_API_KEY=                      # Optional — NVIDIA NIM fallback (build.nvidia.com)

# ---------------------------------------------------------------------------
# Generation — routed through LiteLLM proxy (Groq primary, OpenRouter fallback)
# ---------------------------------------------------------------------------
# Point to the LiteLLM proxy instead of Groq directly.
# Start the proxy first:  make litellm
# To bypass the proxy and hit Groq directly, set to https://api.groq.com/openai/v1
GENERATION_API_BASE=http://localhost:4000/v1
GENERATION_MODEL=qwen3-32b

# LiteLLM proxy master key — set any string to protect the proxy endpoint.
# Leave blank to run the proxy without authentication.
LITELLM_MASTER_KEY=

# ---------------------------------------------------------------------------
# Embeddings (local Ollama)
# ---------------------------------------------------------------------------
OLLAMA_API_BASE=http://127.0.0.1:11434
EMBED_API_BASE=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# Vector store (Qdrant)
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:7333
QDRANT_COLLECTION=documents_chunks

# ---------------------------------------------------------------------------
# OCR (LightOn — requires local vLLM server, see docker-compose)
# ---------------------------------------------------------------------------
OCR_API_BASE=http://127.0.0.1:8002
OCR_MODEL=lightonocr-2-1b-ocr-soup

# ---------------------------------------------------------------------------
# Reranker
# ---------------------------------------------------------------------------
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
EMBED_DEVICE=cpu

# ---------------------------------------------------------------------------
# Retrieval & ranking
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=100
RERANK_TOP_N=10
DOC_MIN_SCORE=0.01
MAX_CHUNK_CHARS=1500
MAX_TABLE_CHARS=3000

# ---------------------------------------------------------------------------
# Chunking — contextual summary LLM (runs during ingestion, not at query time)
# Uses a smaller/faster model than generation to write one sentence per chunk.
# ---------------------------------------------------------------------------
CHUNK_LLM_API_BASE=https://openrouter.ai/api/v1
CHUNK_LLM_MODEL=google/gemma-4-31b-it:free
OPENROUTER_API_KEY=                      # get a free key at openrouter.ai
# CHUNK_LLM_API_KEY=                     # override if using a different provider than OPENROUTER_API_KEY
CHUNK_MAX_TOKENS=1024
CHUNK_MIN_TOKENS=256

# ---------------------------------------------------------------------------
# Table ingestion
# ---------------------------------------------------------------------------
MAX_ROWS_PER_CHUNK=50
MAX_CHARS_PER_TABLE_CHUNK=6000

# ---------------------------------------------------------------------------
# Observability (optional — Langfuse)
# ---------------------------------------------------------------------------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Evaluation (optional — required only for eval/eval_cuad.py)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...   # GPT-4o-mini judge for DeepEval
EVAL_JUDGE_MODE=custom  # custom = one stable JSON judge call; deepeval = original DeepEval metrics
EVAL_JUDGE_MODEL=gpt-4o-mini
EVAL_JUDGE_API_BASE=https://api.openai.com/v1
# EVAL_JUDGE_API_KEY=     # Optional override; defaults to OPENAI_API_KEY
EVAL_JUDGE_CONTEXT_MAX_CHARS=4000
EVAL_JUDGE_CONTEXT_CHUNK_MAX_CHARS=1000
EVAL_CUSTOM_JUDGE_CONTEXT_MAX_CHARS=12000

# ---------------------------------------------------------------------------
# Text-layer PDF parsing — VLM figure descriptions (optional)
# ---------------------------------------------------------------------------
IMAGE_SIZE_LIMIT=0.05        # Fraction of page area; images below this are skipped
VLM_ENABLED=true             # Set false to disable VLM calls entirely (faster, no figure descriptions)
VLM_PROVIDER=groq            # VLM provider used for figure descriptions
VLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct  # Vision model for figure descriptions

# ---------------------------------------------------------------------------
# Slack (optional — required only for the Slack bot interface)
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...   # Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...   # App-Level Token (Socket Mode, connections:write scope)
